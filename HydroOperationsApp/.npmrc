# @google/model-viewer@4.3.1 declares a peer dependency on three@^0.183, but this
# app intentionally pins three@^0.185 (model-viewer runs fine against it). Without
# this, `npm ci` fails with ERESOLVE. Tolerate the peer mismatch for all installs
# (local dev, `rayfin up` build, and the Deploy app launcher's `npm ci`).
legacy-peer-deps=true
