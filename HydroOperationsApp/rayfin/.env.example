# ─────────────────────────────────────────────────────────────────────────────
# Hydro Operations app — Fabric/Entra configuration
#
# The canonical deployer creates `rayfin/.env` from this template for the
# selected target. Do not hand-edit its generated state. The app
# DISCOVERS most artifact ids/URIs at runtime from the workspace by display name
# (see src/services/fabric.ts → ensureConfig), so the values under
# "auto-discovered fallbacks" only need to be set if you want the app to work
# WITHOUT the runtime Fabric discovery call (or to pin a specific artifact).
#
# `rayfin up` / `rayfin env --framework vite` projects every RAYFIN_PUBLIC_*
# value into `.env.local` as VITE_RAYFIN_* for the browser build. Never edit
# `.env.local` by hand. No secrets belong in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Deploy target: the Fabric workspace DISPLAY NAME (used by rayfin.yml) and its GUID.
FABRIC_WORKSPACE_NAME=<your Fabric workspace display name>
RAYFIN_PUBLIC_WORKSPACE_ID=<your Fabric workspace GUID>

# Entra SPA app registration used for browser sign-in (delegated, no secret).
# Must have SPA redirect URIs + the STID (Power BI) and telemetry (Azure Data
# Explorer) delegated permissions — see `npm run setup-live-auth`.
RAYFIN_PUBLIC_AAD_CLIENT_ID=<your Entra SPA app (client) id>
RAYFIN_PUBLIC_TENANT_ID=<your Entra tenant id>

# Native Knowledge Graph: materialize using the selected ontology's Manage graph
# workflow, verify the resulting GraphModel, then supply this explicit mapping.
# This is app configuration, not a Microsoft-owned ontology property. No secret.
# RAYFIN_PUBLIC_ONTOLOGY_GRAPH_BINDING='{"workspaceId":"<workspace-guid>","ontologyId":"<ontology-guid>","graphModelId":"<graph-guid>"}'
# If projected labels differ from exact ontology names, add nodeTypes/edgeTypes:
# each maps a getQueryableGraphType alias to an exact ontology entity/relationship
# name. Namespace label separators are not guessed. Missing mapping/readiness is
# shown as an error; there is no Lakehouse topology fallback.
RAYFIN_PUBLIC_ONTOLOGY_GRAPH_BINDING=

# Explicit build-time opt-in for the isolated energy map.
RAYFIN_PUBLIC_ENABLE_ENERGY_MAP=false

# ── AUTO-DISCOVERED FALLBACKS (optional) ─────────────────────────────────────
# The app resolves these from the workspace by the display names below. Leave
# the *_ID / *_URI values blank to always discover live; set them to pin.

# Telemetry (Eventhouse / KQL). Cluster URI + DB are discovered from the Eventhouse.
RAYFIN_PUBLIC_EVENTHOUSE_NAME=
RAYFIN_PUBLIC_KQL_DATABASE=
RAYFIN_PUBLIC_KQL_CLUSTER_URI=

# Streaming pipeline (OPC UA telemetry). Discovered by name.
RAYFIN_PUBLIC_STREAM_PIPELINE_NAME=02_Pipe_Stream
RAYFIN_PUBLIC_STREAM_PIPELINE_ID=

# Post-seed notebook: seeds SQL and extends the verified v2-backed Data Agent.
# SQL source publication does not prove agent execution readiness.
# Triggered by "Seed & provision" via jobType=RunNotebook. Discovered by name.
RAYFIN_PUBLIC_POSTSEED_NOTEBOOK_NAME=RTI_011_seed_sql_wire_graphql_agent
RAYFIN_PUBLIC_POSTSEED_NOTEBOOK_ID=

# Both the SPA and hosted crew read assets/weather through the delegated connector.
RAYFIN_PUBLIC_LAKEHOUSE_NAME=
RAYFIN_PUBLIC_LAKEHOUSE_ID=
# Filled from the selected Lakehouse's live sqlEndpointProperties.id, not its item ID.
RAYFIN_PUBLIC_LAKEHOUSE_SQL_ENDPOINT_ID=
RAYFIN_PUBLIC_LAKEHOUSE_SQL_ENDPOINT=

# The Copilot panel discovers the latest RTI_Demo_Agent_* item and constructs its
# published MCP endpoint at runtime. Before invoking it, the app requires live
# Ontology generation 2 and a matching published ontology source ID/workspace.
# Unverifiable sources are blocked; backend capability failures still propagate.
# No Data Agent URL or item ID is configured here. REST /v1 and name suffixes such
# as V6/V9 do not refer to ontology generation.

# ── FOUNDRY HOSTED MULTI-AGENT RUNTIME ───────────────────────────────────────
# Filled by the canonical deployer from verified target metadata. Do not copy
# project endpoints, model deployments or immutable runtime identities from
# another workspace. Users need Foundry User access to the selected project.
RAYFIN_PUBLIC_FOUNDRY_PROJECT_ENDPOINT=
RAYFIN_PUBLIC_FOUNDRY_SUBSCRIPTION_ID=
RAYFIN_PUBLIC_FOUNDRY_DEPLOYMENT=
RAYFIN_PUBLIC_FOUNDRY_INVOCATIONS_URL=
RAYFIN_PUBLIC_FOUNDRY_APP_INSIGHTS_RESOURCE_ID=
RAYFIN_PUBLIC_ORCHESTRATOR_VERSION=
RAYFIN_PUBLIC_ORCHESTRATOR_IMAGE_DIGEST=
RAYFIN_PUBLIC_ORCHESTRATOR_SOURCE_DIGEST=

# Will be put in upper right corner of UI
RAYFIN_PUBLIC_UI_CREDIT_LINE_1=Developers: Dibakar Dharchoudhury, Jon Olav Abeland, Gareth O'Brien, Espen Brandt-Kjelsen
RAYFIN_PUBLIC_UI_CREDIT_LINE_2=vTeam Hydro: Alex Grubb, Gareth O'Brien, Frode Odinsen, Jon Olav Abeland
RAYFIN_PUBLIC_UI_CREDIT_LINE_3=Hackathon Participants 2026: Ondrej Spilka, Aizo Wiebenga, Gareth O'Brien, Jon Olav Abeland, Frode Odinsen, Espen Brandt-Kjelsen, Alex Grubb, Dibakar Dharchoudhury, Yvonne Brzesowsky-Ruys