{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "ESNext.Decorators"],
    "strict": true,
    "outDir": "./.temp/compiled",
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["./data/**/*.ts"],
  "exclude": ["node_modules", "dist", ".temp"]
}