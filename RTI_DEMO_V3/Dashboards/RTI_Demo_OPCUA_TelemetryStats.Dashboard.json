  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | summarize ['Total Events'] = count()",
      "id": "a1000000-0000-4000-8000-000000000001",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | summarize ['Event Count'] = count() by ['Time Window'] = bin(event_time, 30m) | sort by ['Time Window'] desc",
      "id": "a1000000-0000-4000-8000-000000000002",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | sort by event_time desc | take 1000",
      "id": "a1000000-0000-4000-8000-000000000003",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | extend Turbine = extract(@';s=([^.]+)\\.', 1, opcua_node_id) | summarize ['Total'] = count(), ['Good'] = countif(quality == 'GOOD'), ['Bad'] = countif(quality == 'BAD'), ['Uncertain'] = countif(quality == 'UNCERTAIN') by Turbine | sort by Turbine asc",
      "id": "a1000000-0000-4000-8000-000000000004",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | extend Turbine = extract(@';s=([^.]+)\\.', 1, opcua_node_id) | summarize ['Good'] = countif(quality == 'GOOD'), ['Bad'] = countif(quality == 'BAD'), ['Uncertain'] = countif(quality == 'UNCERTAIN') by Turbine | project Turbine, ['Good'], ['Bad'], ['Uncertain'] | sort by Turbine asc",
      "id": "a1000000-0000-4000-8000-000000000005",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | summarize ['Event Count'] = count() by bin(event_time, 30m) | project event_time, ['Event Count'] | sort by event_time asc",
      "id": "a1000000-0000-4000-8000-000000000006",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | extend Turbine = extract(@';s=([^.]+)\\.', 1, opcua_node_id) | where Turbine == 'T001' | extend Signal = extract(@'\\.([^.]+)$', 1, opcua_node_id) | summarize AvgValue = avg(value) by Signal, bin(event_time, 1m) | project event_time, Signal, AvgValue | sort by event_time asc",
      "id": "a1000000-0000-4000-8000-000000000007",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b0b2067e-2479-438f-96ae-31079b244504"
      },
      "text": "['OPCUAEvents'] | where event_time between (_startTime .. _endTime) | extend Turbine = extract(@';s=([^.]+)\\.', 1, opcua_node_id) | where Turbine == 'T002' | extend Signal = extract(@'\\.([^.]+)$', 1, opcua_node_id) | summarize AvgValue = avg(value) by Signal, bin(event_time, 1m) | project event_time, Signal, AvgValue | sort by event_time asc",
      "id": "a1000000-0000-4000-8000-000000000008",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    }
  ],
  "embeddedApps": []
}
